{
  "name": "regbot",
  "version": "1.19.1",
  "type": "module",
  "imports": {
    "#root/*": "./build/src/*"
  },
  "scripts": {
    "build": "node scripts/compile-locales.js && tsc && NODE_ENV=development npx mikro-orm cache:generate --combined && cp temp/metadata.json build/metadata.json",
    "clean": "rm -rf build node_modules temp src/_messages.gen.js",
    "dev": "nodemon",
    "format": "eslint . --fix",
    "lint": "eslint .",
    "make-migrations": "tsc && npx mikro-orm migration:create",
    "migrate": "tsc && npx mikro-orm migration:up",
    "prepare": "(husky && node scripts/compile-locales.js) || true",
    "start": "npm run build || exit 1 && node ./build/src/main.js",
    "start:prod": "node ./build/src/main.js",
    "test": "npm run build && NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" REGBOT_ENV_FILE_PATH=\"./.env.test\" npx jest",
    "extract_data_from_history": "node scripts/extract_data_from_history.js"
  },
  "author": "Tamika Nomara <taminomara@gmail.com>",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@grammyjs/auto-chat-action": "0.1.1",
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/hydrate": "1.7.0",
    "@grammyjs/i18n": "1.1.2",
    "@grammyjs/menu": "^1.5.0",
    "@grammyjs/parse-mode": "2.3.0",
    "@grammyjs/types": "5.0.0",
    "@mikro-orm/better-sqlite": "6.6.14",
    "@mikro-orm/core": "6.6.14",
    "@mikro-orm/migrations": "6.6.14",
    "callback-data": "1.1.1",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "grammy": "^1.46.0",
    "grammy-guard": "0.5.0",
    "iso-639-1": "3.1.6",
    "moment-timezone": "^0.6.5",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "prom-client": "^15.1.3",
    "sanitize-html": "2.17.1",
    "znv": "0.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@fluent/syntax": "^0.19.0",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@jest/globals": "^30.5.2",
    "@mikro-orm/cli": "6.6.14",
    "@mikro-orm/reflection": "6.6.14",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "@types/sanitize-html": "^2.16.2",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "eslint": "^9.39.5",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-unicorn": "^65.0.1",
    "globals": "^14.0.0",
    "husky": "9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "17.6.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "4.3.0",
    "source-map": "^0.8.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "lint-staged": {
    "*.ts": "eslint"
  },
  "mikro-orm": {
    "configPaths": [
      "./build/src/backend/micro-orm-config.js"
    ]
  },
  "nodemonConfig": {
    "ext": "js,jsx,ts,json,ftl",
    "ignore": [
      "build/*",
      "temp/*",
      "src/backend/migrations/*",
      "src/_messages.ts"
    ]
  },
  "overrides": {
    "eslint-config-airbnb-base": {
      "eslint": "$eslint"
    }
  }
}
